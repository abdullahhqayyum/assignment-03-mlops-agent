          },
          "limit": {
            "default": 5,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          },
          "metric": {
            "default": "f1",
            "maxLength": 60,
            "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$",
            "title": "Metric",
            "type": "string"
          },
          "direction": {
            "default": "maximize",
            "enum": [
              "maximize",
              "minimize"
            ],
            "title": "Direction",
            "type": "string"
          }
        },
        "title": "BestRun",
        "type": "object"
      }
    }
  },
