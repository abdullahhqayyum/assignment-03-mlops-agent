      "description": "List a bounded number of recent runs across specified or all visible experiments",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "experiment_ids": {
            "items": {
              "maxLength": 250,
              "minLength": 1,
              "pattern": "^[a-zA-Z0-9_.:+@=-]+$",
              "type": "string"
            },
            "maxItems": 10,
            "title": "Experiment Ids",
            "type": "array"
          },
          "limit": {
            "default": 5,
            "maximum": 50,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "title": "Runs",
        "type": "object"
      }
    }
  },
