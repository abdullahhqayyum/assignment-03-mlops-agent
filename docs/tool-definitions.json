  {
    "type": "function",
    "function": {
      "name": "dvc_dataset_version",
      "description": "Read committed DVC hash and Git revision; use dataset.git_commit from MLflow",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "revision": {
            "default": "HEAD",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./~-]*$",
            "title": "Revision",
            "type": "string"
          }
        },
        "title": "DatasetVersion",
        "type": "object"
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "dvc_compare_versions",
      "description": "Compare two committed dataset references with dvc diff",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "old_revision": {
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./~-]*$",
            "title": "Old Revision",
            "type": "string"
          },
          "new_revision": {
            "default": "HEAD",
            "maxLength": 100,
            "minLength": 1,
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_./~-]*$",
            "title": "New Revision",
            "type": "string"
          }
        },
        "required": [
          "old_revision"
        ],
        "title": "DatasetDiff",
        "type": "object"
      }
    }
  },
