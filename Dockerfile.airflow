FROM apache/airflow:slim-3.1.0-python3.11
RUN pip install --no-cache-dir "apache-airflow==3.1.0" \
    "mlflow-skinny==3.5.1" "scikit-learn==1.7.2" "numpy==2.3.4" \
    "scipy==1.16.3" "joblib==1.5.2" "PyYAML==6.0.3" "SQLAlchemy==1.4.54" \
    "apache-airflow-providers-postgres==6.3.0"
RUN pip install --no-cache-dir "pandas==2.3.3"
WORKDIR /workspace
